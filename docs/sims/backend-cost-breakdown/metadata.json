{
  "title": "后端月度成本构成与降本空间",
  "subject": "AI 应用后端集成 — 成本口径、免费额度与每会话后端成本",
  "creator": "EdwardChenz",
  "description": "交互式条形图：按七项成本口径算出优化前的月度后端费用合计，找出占比最高的单项（边缘函数出网 48.7%），并把账单摊薄成每会话后端成本 0.0100 元。单价为教学用示意价。",
  "date": "2026-10-06",
  "type": "Interactive Simulation",
  "format": "text/html",
  "language": "zh",
  "rights": "CC BY-NC-SA 4.0",
  "grade_level": "本科 / 职业培训",
  "bloom_levels": ["Analyze"],
  "duration": "6-9 分钟",
  "prerequisites": ["免费额度", "成本公式", "出网计费", "固定成本分摊", "月度会话数"],
  "learning_objectives": [
    "学习者将按七项成本口径计算优化前后的月度后端费用，并选出占比最高的单项与其降本幅度；判定条件是优化前合计 286.71 元、边缘函数出网占比 48.7%、优化后每会话后端成本 0.0100 元。"
  ],
  "framework": "Chart.js",
  "chart_library_version": "4.4.1",
  "canvas_dimensions": "宽度自适应；图表区 360px + 控件区 540px",
  "iframe_height": 902,
  "responsive": "Width-responsive（window resize 时 chart.resize()）",
  "dependencies": "Chart.js CDN (4.4.1)",
  "accessibility": ["canvas role=img 与 aria-label", "输入框与下拉框 aria-label", "键盘可达控件", "免费额度挡住的项用灰色 + 0.00 标签双重标注，不只靠颜色"],
  "controls": [
    { "type": "input", "label": "Q1 优化前的月度后端费用合计", "unit": "元", "tolerance": 0.01 },
    { "type": "select", "label": "Q2 占比最高的单项" },
    { "type": "input", "label": "Q2 占比最高的单项的占比", "unit": "%", "tolerance": 0.5 },
    { "type": "input", "label": "Q3 优化后每会话后端成本", "unit": "元", "tolerance": 0.0005 },
    { "type": "button", "label": "检查答案" },
    { "type": "button", "label": "重来" }
  ],
  "model": {
    "type": "算术判定（确定性计算）",
    "variables": ["七项用量", "免费额度", "单价", "月度会话数 18,000"],
    "equations": [
      "单项费用 = max(0, 用量 − 免费额度) × 单价",
      "边缘函数调用 = max(0, 260,000 − 500,000) ÷ 1000 × 0.008 = 0.00 元",
      "合计 = 七项之和，取整到 0.01 元",
      "占比 = 单项 ÷ 合计，保留一位小数",
      "每会话成本 = 合计 ÷ 18,000，保留四位小数",
      "降本幅度 =（优化前 − 优化后）÷ 优化前，保留一位小数"
    ],
    "data": {
      "数据库实例": { "用量": "1 个组织", "免费额度": "0", "单价": "68.00", "单位": "元/月", "费用": 68.0, "占比": "23.7%" },
      "对象存储": { "用量": "62 GB", "免费额度": "0", "单价": "0.0217", "单位": "元/GB·月", "费用": 1.35, "占比": "0.5%" },
      "对象存储出网": { "用量": "210 GB", "免费额度": "0", "单价": "0.36", "单位": "元/GB", "费用": 75.6, "占比": "26.4%" },
      "实时出站消息": { "用量": "0.17 GB", "免费额度": "2 GB", "单价": "0.36", "单位": "元/GB", "费用": 0.0, "占比": "0.0%" },
      "边缘函数调用": { "用量": "260,000 次", "免费额度": "500,000 次", "单价": "0.008", "单位": "元/千次", "费用": 0.0, "占比": "0.0%" },
      "边缘函数出网": { "用量": "388 GB", "免费额度": "0", "单价": "0.36", "单位": "元/GB", "费用": 139.68, "占比": "48.7%" },
      "备份存储": { "用量": "96 GB", "免费额度": "0", "单价": "0.0217", "单位": "元/GB·月", "费用": 2.08, "占比": "0.7%" },
      "优化后合计": 179.63,
      "优化后降幅": "37.4%",
      "边缘函数出网优化后": { "用量": "96 GB", "费用": 34.56, "占优化后总价": "19.2%" },
      "每会话后端成本": { "优化前": 0.0159, "优化后": 0.01 },
      "单会话模型成本": 0.0125,
      "两项相加": 0.0225,
      "后端占比": "44.4%"
    },
    "assumptions": [
      "单价与免费额度为教学用示意价，不是厂商报价",
      "优化后 179.63 元与降幅 37.4% 取自本章的优化前后对照表",
      "规格块只给出边缘函数出网一项的优化后数值，其余两项降本动作的单项金额未给出，因此图表只画优化前口径，优化前后对照以文字呈现"
    ],
    "limitations": [
      "不模拟突发流量、请求数增长或用量随时间的漂移",
      "不评估三项降本动作各自的实施成本与回滚风险"
    ]
  }
}