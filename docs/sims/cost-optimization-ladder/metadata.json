{
  "title": "数据成本优化阶梯与月成本",
  "subject": "企业数据工程 — 查询侧优化阶梯、存储侧固定成本与月成本",
  "creator": "EdwardChenz",
  "description": "交互式阶梯柱状图：调节集群小时单价并在六阶段阶梯上勾选已实施的优化措施，观察累计集群小时与月成本的实时变化，并计算单措施收益排序与两种降幅。",
  "date": "2026-10-06",
  "type": "Interactive Simulation",
  "format": "text/html",
  "language": "zh",
  "rights": "CC BY-NC-SA 4.0",
  "grade_level": "本科 / 职业培训",
  "bloom_levels": ["Evaluate"],
  "duration": "8-12 分钟",
  "prerequisites": ["月成本公式", "集群小时", "存储 TB", "单措施节省的集群小时", "累计降幅", "一次性成本与收益稳定性"],
  "learning_objectives": [
    "学习者将调节集群小时单价并在六阶段阶梯上选择已实施的优化措施，观察月集群小时与月成本的实时变化，并在三道挑战题中给出五个措施的单措施收益排序、全部实施后的月成本与降幅、只实施前三项后的月成本与降幅。"
  ],
  "framework": "Chart.js",
  "chart_library_version": "4.4.1",
  "canvas_dimensions": "宽度自适应；图表区 400px + 控件区 624px",
  "iframe_height": 1026,
  "responsive": "Width-responsive（window resize 时 chart.resize()）",
  "dependencies": "Chart.js CDN (4.4.1)",
  "accessibility": ["canvas role=img 与 aria-label", "勾选框与滑块 aria-label", "键盘可达控件", "基线柱用深灰 + “未实施（跳过）”文字标注第二重线索，不只靠颜色缺失"],
  "controls": [
    { "type": "checkbox", "label": "已实施 分区裁剪" },
    { "type": "checkbox", "label": "已实施 列裁剪" },
    { "type": "checkbox", "label": "已实施 查询合并" },
    { "type": "checkbox", "label": "已实施 提高缓存命中率" },
    { "type": "checkbox", "label": "已实施 小文件合并" },
    { "type": "slider", "label": "集群小时单价", "min": 1.5, "max": 5.0, "step": 0.1, "default": 2.6, "unit": "元" },
    { "type": "select", "label": "Q1 收益排序 ①" },
    { "type": "select", "label": "Q1 收益排序 ②" },
    { "type": "select", "label": "Q1 收益排序 ③" },
    { "type": "select", "label": "Q1 收益排序 ④" },
    { "type": "select", "label": "Q1 收益排序 ⑤" },
    { "type": "input", "label": "Q2 五项全做后月成本", "unit": "元", "tolerance": 1 },
    { "type": "input", "label": "Q2 降幅", "unit": "%", "tolerance": 0.1 },
    { "type": "input", "label": "Q3 只做前三项月成本", "unit": "元", "tolerance": 1 },
    { "type": "input", "label": "Q3 降幅", "unit": "%", "tolerance": 0.1 },
    { "type": "button", "label": "检查答案" },
    { "type": "button", "label": "重来" }
  ],
  "model": {
    "type": "算术判定（确定性计算）",
    "variables": ["集群小时单价（1.5–5.0，步长 0.1，默认 2.6）", "五个措施是否已实施", "存储量 4.6 TB 与存储单价 900 元/TB/月"],
    "equations": [
      "月成本 = 累计集群小时 × 集群小时单价 + 4,140 元",
      "存储侧恒为 4.6 TB × 900 = 4,140 元，不受勾选与单价调节影响",
      "累计集群小时 = 5,760 − 所有已勾选措施的单措施节省之和",
      "累计降幅 = 1 − 累计集群小时 ÷ 5,760，保留一位小数",
      "基线月成本 = 5,760 × 2.6 + 4,140 = 19,116 元"
    ],
    "data": {
      "单措施节省": { "分区裁剪": 1500, "列裁剪": 450, "查询合并": 250, "提高缓存命中率": 440, "小文件合并": 260 },
      "累计集群小时": { "基线": 5760, "一 分区裁剪": 4260, "二 列裁剪": 3810, "三 查询合并": 3560, "四 提高缓存命中率": 3120, "五 小文件合并": 2860 },
      "累计降幅": { "基线": "0%", "一": "26.0%", "二": "33.9%", "三": "38.2%", "四": "45.8%", "五": "50.3%" },
      "单措施收益排序": ["分区裁剪 1,500", "列裁剪 450", "提高缓存命中率 440", "小文件合并 260", "查询合并 250"],
      "全部实施后": { "月成本": 11576, "降幅": "39.4%" },
      "只做前三项": { "月成本": 13396, "降幅": "29.9%" }
    },
    "assumptions": [
      "六阶段的单措施节省、累计集群小时与累计降幅出自本章「数据成本优化」一节的两张表与成本公式段落",
      "单措施节省相加 2,900 与基线减终值 2,900 一致（自洽性校验）",
      "可调量范围为教学设定，锚定在实测单价 2.6 元，默认值落在 0.1 的步长网格上，随机种子 20261006"
    ],
    "limitations": [
      "不计入三项降本动作的一次性实施成本，也不建模缓存命中率随业务习惯回落的风险",
      "挑战题的答案一律按默认单价 2.6 元的口径计算，与滑块当前值无关",
      "存储量不随措施变化，因此降幅与实施数量不成正比"
    ]
  }
}