  "chapter_anchors": {
    "idempotency_key": "CL-20261006-0031:risk-score",
    "deadline_ms": 2000,
    "first_completed_ms": 780,
    "card_p95_ms": 800,
    "discarded_rollback_index": 6,
    "duplicate_charge_fen": 3.0,
    "timeout_threshold_range": [500, 5000],
    "timeout_threshold_step": 100
  },
  "model": {
    "type": "状态机模型（确定性规则推演）",
    "variables": ["事件序号 no", "到达时刻 t", "超时阈值 T", "当前状态序号"],
    "equations": [
      "rank(created) 1 < rank(accepted) 2 < rank(running) 3 < rank(completed) 4",
      "当前状态序号 > 事件状态序号 → 判回退，必须丢弃并记审计日志",
      "事件状态序号 = 当前状态序号 → 判幂等重复，返回首次结果且不执行",
      "超时判定：t >= T 且（非终态）→ 判超时",
      "重复扣费 = 被接受的回退次数 × 1.5 分，保留一位小数"
    ],
    "assumptions": [
      "回退次数上限 3 次，源于一次委托最多重试一次与通道补发两次",
      "序号 6 的来源是编排侧重试时复用了同一个 task_id，通道缓冲把旧事件补发出来",
      "回退次数为 0 时扣费为 0.0 分",
      "三道挑战题的标准答案（序号 6、重复扣费 3.0 分、不应判超时）直接取自规格块，不由模拟器现场推算"
    ],
    "limitations": [
      "不模拟通道的实际乱序与重投，只按规格块给出的十二条固定事件推演",
      "核保规则只按按次计价折算，不建模模型调用的真实成本",
      "延迟到达的观测时刻不改变任务已完成这一事实，模拟器不追踪上游执行器的真实进度"
    ]
  },
  "misconceptions_targeted": [
    "状态事件按到达顺序处理即可，重复事件无害（第 1 题）",
    "回退事件无害，因为对方的实现不会故意回退（第 1 题）",
    "委托超时后重试不会产生额外费用（第 2 题）"
  ],
