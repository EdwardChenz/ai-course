  "chapter_anchors": {
    "nodes": 8,
    "edges": 12,
    "first_hop_neighbors": 5,
    "two_hop_cumulative_nodes": 21,
    "three_hop_cumulative_nodes": 63,
    "max_hops": 3,
    "max_fanout": 50,
    "metric_values": [35.2, 28.4, 41.0, 32.1, 19.8]
  },
  "model": {
    "type": "图遍历模型（确定性 BFS + 关系语义过滤）",
    "variables": ["起点 seed", "展开深度 depth（0-3）", "跳数 hops", "结果集 entity set"],
    "equations": [
      "hops = 路径上的有向边数（1 <= hops <= 3）",
      "路径长度按有向边计数；允许在起点处反向走一条边，反向边同样计入跳数",
      "属性过滤只作用在路径末端节点，比较用严格大于或严格小于",
      "缺属性的节点既不满足条件也不出现在结果集里"
    ],
    "assumptions": [
      "COVERS 与 REPORTS 沿箭头方向展开；BELONGS_TO 视为双向，因为行业节点是枢纽，规格块第 1、4 题的答案要求从行业节点走出来",
      "跳数上限 3 跳、单跳扇出上限 50；超扇出按 confidence 降序截断并标记已截断（本图最大出度为 3，不触发截断）",
      "六题的跳数与结果集直接取自规格块 Content 表，不由模拟器现场计算"
    ],
    "limitations": [
      "图谱只有 8 个节点 12 条边，是章节示例图谱的示意子集，不反映真实图规模",
      "不含社区发现算法的运行结果，也不模拟向量检索的召回",
      "探索模式展开全部相邻节点，挑战题的正确答案由题干的关系语义与属性过滤决定，两者口径不完全一致"
    ]
  },
  "misconceptions_targeted": [
    "同行业的两家公司可以从一家直接跳到另一家，中间不需要经过行业节点（第 1 题）",
    "遍历关系时箭头方向不影响结果（第 2、6 题）",
    "属性过滤可以在路径开始前一次性完成，不必等到末端（第 3、5 题）",
    "把缺数据当成 0 处理（第 5 题：比亚迪没有指向毛利率的边）"
  ]
}
