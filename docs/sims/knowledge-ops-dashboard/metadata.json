{
  "title": "知识库运营指标看板",
  "subject": "RAG 进阶 — 知识库运营指标、门禁与处置优先级",
  "creator": "EdwardChenz",
  "description": "交互式看板：六项知识库运营指标的周度对比与四道可见门禁。学习者先算相对变化，再从四项越线指标中选出必须立即处置的三项并排序，全部锁定后揭晓。",
  "date": "2026-10-06",
  "type": "Interactive Simulation",
  "format": "text/html",
  "language": "zh",
  "rights": "CC BY-NC-SA 4.0",
  "grade_level": "本科 / 职业培训",
  "bloom_levels": ["Analyze"],
  "duration": "8-12 分钟",
  "prerequisites": [
    "自助解决率",
    "知识覆盖率",
    "负反馈率",
    "每次成功问答成本",
    "检索调用量 P95",
    "端到端 P95 延迟",
    "过期文档占比"
  ],
  "learning_objectives": [
    "学习者将在一组六指标的周度变化数据中，按相对变化幅度排序并选出必须立即处置的三项指标，判断正确且能指出被淘汰项的幅度差。"
  ],
  "framework": "Chart.js",
  "chart_library_version": "4.4.1",
  "canvas_dimensions": "宽度自适应；图表区 380px + 控件区 487px",
  "iframe_height": 869,
  "responsive": "Width-responsive（window resize 时 chart.resize()）",
  "dependencies": "Chart.js CDN (4.4.1)",
  "accessibility": ["canvas role=img 与 aria-label", "输入框与下拉框 aria-label", "键盘可达控件", "越线项同时用颜色、0% 门禁线位置与 tooltip 文案标注，不只依赖红绿"],
  "controls": [
    { "type": "input", "label": "每次成功问答成本 的相对变化", "unit": "%", "step": 0.1, "tolerance": 0.5 },
    { "type": "input", "label": "端到端 P95 延迟 的相对变化", "unit": "%", "step": 0.1, "tolerance": 0.5 },
    { "type": "input", "label": "拒答准确率 的相对变化", "unit": "%", "step": 0.1, "tolerance": 0.5 },
    { "type": "input", "label": "召回命中率 的相对变化", "unit": "%", "step": 0.1, "tolerance": 0.5 },
    { "type": "input", "label": "忠实度 的相对变化", "unit": "%", "step": 0.1, "tolerance": 0.5 },
    { "type": "input", "label": "自助解决率 的相对变化", "unit": "%", "step": 0.1, "tolerance": 0.5 },
    { "type": "select", "label": "处置第 1 顺位" },
    { "type": "select", "label": "处置第 2 顺位" },
    { "type": "select", "label": "处置第 3 顺位" },
    { "type": "button", "label": "锁定 6 项相对变化" },
    { "type": "button", "label": "锁定处置顺序" },
    { "type": "button", "label": "重来" }
  ],
  "model": {
    "type": "算术判定（确定性计算）",
    "variables": ["六项指标的上周值与本周值", "门禁方向（上限 / 下限）"],
    "equations": [
      "相对变化 =（本周值 − 上周值）÷ 上周值 × 100%，保留 1 位小数",
      "入选前三 = 越线项中相对变化绝对值排前三者；相对变化恰为 0% 排在所有非零项之后",
      "图轴换算 = 门禁为上限时取（值 ÷ 门禁 − 1）× 100%；门禁为下限时取（1 − 值 ÷ 门禁）× 100%，使越线一律指向正方向"
    ],
    "data": {
      "每次成功问答成本": { "上周": "0.014 元", "本周": "0.021 元", "门禁": "<= 0.02 元", "越线": true, "相对变化": "+50.0%", "入选前三": true },
      "端到端 P95 延迟": { "上周": "3.4 s", "本周": "4.9 s", "门禁": "<= 4.5 s", "越线": true, "相对变化": "+44.1%", "入选前三": true },
      "拒答准确率": { "上周": "91%", "本周": "80%", "门禁": ">= 90%", "越线": true, "相对变化": "-12.1%", "入选前三": true },
      "召回命中率": { "上周": "91%", "本周": "88%", "门禁": ">= 90%", "越线": true, "相对变化": "-3.3%", "入选前三": false },
      "忠实度": { "上周": "95%", "本周": "94%", "门禁": ">= 93%", "越线": false, "相对变化": "-1.1%", "入选前三": false },
      "自助解决率": { "上周": "62%", "本周": "61%", "门禁": ">= 60%", "越线": false, "相对变化": "-1.6%", "入选前三": false }
    },
    "assumptions": [
      "六项门禁出自本章「知识库运营指标」与「幻觉抑制策略」的对照表",
      "本周值为配置 5 全开与基线归因的结果，属合成数据；忠实度与自助解决率为小幅回退的教学设定",
      "被淘汰项与第三名的幅度差为 8.8 个百分点（12.1% 对 3.3%）"
    ],
    "limitations": [
      "看板图为门禁归一后的偏离百分比，不是原始量纲；原始值在下方表格中逐行列全",
      "不模拟指标之间的因果关系，只呈现周度对比"
    ]
  }
}